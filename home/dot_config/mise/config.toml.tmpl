# Global toolchain, owned by mise on all three machines (suse / ubuntu / mac).
# Everything installs under ~/.local/share/mise — no root needed.
# To add or upgrade a tool: edit this file, then `chezmoi apply && mise install`.

[tools]
python = "3.12"
node = "22"
# vim.pack (built-in plugin manager) requires neovim >= 0.12
neovim = "latest"
ripgrep = "latest"
fd = "latest"
fzf = "latest"
delta = "latest"
starship = "latest"
uv = "latest"
# needed by nvim-treesitter to build parsers. Prebuilt binaries after 0.24.x
# are compiled on Ubuntu 24.04 and need glibc >= 2.39, newer than SLE ships,
# so the suse role pins the last release that runs there.
tree-sitter = "{{ if eq .role "suse" }}0.24.7{{ else }}latest{{ end }}"
